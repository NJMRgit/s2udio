#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    max_fps: 60,
    status_update_interval_ms: 16,
    // Round 23: s2udio's own .lrc library lives inside its config dir;
    // the user's MPD library is checked first (read-only) for their own
    // .lrc files and is never written to.
    lyrics_dir: "~/.config/s2udio/lyrics",
    enable_lyrics_hot_reload: true,
    // Round 38: lyrics source priority. local-first (default): colocated
    // .lrc sidecar -> lyrics_dir mirror -> lyrics index, then the
    // on_song_change network fetch as the last fallback. local-only:
    // local files only — the fetch is never spawned (on_song_change is
    // skipped; the manual "fetch lyrics" button still works).
    lyrics_source: LocalFirst,
    on_song_change: ["rmpc-fetch-lyrics"],
    exec_on_song_change_at_start: true,
    cava: (
        framerate: 90,
        autosens: true,
        lower_cutoff_freq: 20,
        higher_cutoff_freq: 15000,
        input: (
            // Round 30: cava is PipeWire-only — capture the default output
            // ("auto") or a specific sink monitor / virtual source. A
            // legacy `method: Fifo` in an old config is ignored.
            source: "auto",
            // Round 29: name the node s2udio creates (node.name/media.name
            // in pw-dump/pavucontrol). Requires the cava node-name shim
            // built by setup.sh.
            // node_name: Some("s2udio-cava"),
        ),
    ),
    radio: (
        playlist: "radio",
        location: None,
        max_favourites: 10,
    ),
    jellyfin: (
        config_file: None,
    ),
    video: (
        playback: ask,
    ),
    torrent: (
        enabled: true,
        port: 3030,
        min_download_speed_kbps: 500,
        warmup_secs: 5,
        max_wait_secs: 15,
        no_peers_timeout_secs: 30,
        cache_dir: "~/.cache/s2udio/torrents",
        auto_pick_file: true,
        keep_after_play: false,
        socks_proxy: None,
    ),
    keybinds: (
        // Round 73.2 revision B (user request, 2026-09-11): wasd movement is
        // back (`w`/`s` navigation, `w`/`s`/`a`/`d` in the folder tree),
        // `c` cycles to the next library tab, `S` (Shift+S) jumps to the
        // library's search page with the input focused, `Q` (Shift+Q) is
        // the only quit key and `q` is deliberately UNBOUND. `W`/`S` are
        // NOT SelectUp/SelectDown any more (S is the search jump; range
        // selection is Shift+Up/Down). NOTE: a config file with
        // `clear: true` (e.g. ~/.config/s2udio/config.ron) does NOT fall
        // back to this block — those users must migrate their own keybinds.
        global: {
            " ":          TogglePause,
            "<Tab>":      NextTab,
            "<S-Tab>":    ToggleMpdMode,
            ">":          NextTrack,
            // Round 73.2: `Q` is Shift+Q = Quit (the key system cannot tell
            // Shift+Q from bare Q); bare `q` is left free.
            "Q":          Quit,
            // `c` cycles to the next library tab on library tabs and keeps
            // the queue map's ToggleChapters on the Queue tab (the tab's own
            // pane claims the queue half first).
            "c":          NextLibraryTab,
            "<S-Right>":  NextLibraryTab,
            "<S-Left>":   PreviousLibraryTab,
            // Round 73.2 revision B: `S` opens this library's search page
            // with the query input focused (no-op on tabs without a search
            // page).
            "S":          LibrarySearch,
            "<Esc>":      ShowSettings,
            // Round 55.5: Ctrl+D opens the downloads modal.
            "<C-d>":      ShowDownloads,
        },

        navigation: {
            "<Esc>":      Close,
            "<CR>":       Confirm,
            // wasd movement. Round 73.2 revision B: `w`/`s` are back; `W`/`S`
            // stay unbound (S is the search jump). The lyrics letter actions
            // below are NOT movement and stay.
            "w":          Up,
            "<Up>":       Up,
            "s":          Down,
            "<Down>":     Down,
            "<S-Up>":     SelectUp,
            "<S-Down>":   SelectDown,
            "<C-a>":      SelectAll,
            // Lyrics edit mode (round 34): ←/→ across words, +/− nudge
            // the selected word's time (10 ms), <C-s> saves.
            "<Left>":     Left,
            "<Right>":    Right,
            "<S-+>":      NudgeUp,
            "-":          NudgeDown,
            "<C-s>":      SaveLyrics,
            // Lyrics edit mode (round 35/41): d delete the selected word
            // (line removed only when empty), e edit text, i/a insert a
            // new word into the line (before/after the selected word),
            // o/O add a whole new line after/before, t set line
            // timestamp.
            "d":          DeleteLyricsWord,
            "e":          EditLyricsLine,
            "i":          InsertLyricsLineBefore,
            "a":          InsertLyricsLineAfter,
            "o":          AddLyricsLineAfter,
            "O":          AddLyricsLineBefore,
            "t":          SetLyricsLineTime,
            "<C-c>":      SaveLyricsAndExit,
        },

        directories: {
            // Round 73.2 revision B: the wasd directory keys are back
            // (tree highlight move + collapse/expand), plus the arrow twins
            // `<-` (FolderCollapse) and `->` (PlayFile — the tree browser
            // treats it like FolderExpand on a folder row).
            "w":          FolderUp,
            "s":          FolderDown,
            "a":          FolderCollapse,
            "d":          FolderExpand,
            "<Right>":    PlayFile,
            "<Left>":     FolderCollapse,
        },

        // The queue sub-page cycler. Round 73.2: this section MUST list `c`
        // explicitly — the config merge drops every overridden key sequence
        // from the other maps, so the global `c` (next library tab)
        // would otherwise delete the queue's `c` and the Audio / Video /
        // Chapters / Radio cycling with it.
        queue: {
            "c":          ToggleChapters,
            "<S-Tab>":    ToggleChapters,
        },
    ),
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        // Round 62 (Q3): the Audio/Video/Radio/Chapters
                        // toggle row lives at the TOP of the queue page,
                        // directly under the navbar. This 1-row bare strip
                        // is where QueuePane::render_toggle_on_border paints
                        // it (it renders even while the queue pane is hidden
                        // in Radio mode).
                        size: "1",
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (
                                    size: "1",
                                    pane: Pane(Empty())
                                ),
                                (
                                    size: "100%",
                                    pane: Pane(Empty())
                                ),
                            ]
                        )
                    ),
                    (
                        // Round 62 (Q2): the radio browser sub-page. It
                        // fills the whole queue body only while the toggle
                        // is in Radio mode (the mode-aware pane hiding
                        // collapses the art/lyrics/queue panes then); in
                        // every other mode this pane is hidden and the
                        // normal queue content shows.
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(Radio)
                    ),
                    (
                        size: "20",
                        window_sizes: [(65, "20"), (55, "10"), (43, "10"), (33, "0")],
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (
                                    size: "2.14r",
                                    borders: "ALL",
                                    border_symbols: Rounded,
                                    pane: Pane(AlbumArt)
                                ),
                                (
                                    size: "100%",
                                    borders: "ALL",
                                    border_symbols: Rounded,
                                    pane: Pane(Lyrics)
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "100%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "3",
                                    borders: "LEFT | RIGHT | TOP",
                                    border_symbols: Inherited(parent: Rounded, bottom_left: "├", bottom_right: "┤",),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "1",
                                                pane: Pane(Empty())
                                            ),
                                            (
                                                size: "100%",
                                                pane: Pane(QueueHeader())
                                            ),
                                        ]
                                    )
                                ),
                                (
                                    size: "100%",
                                    collapse_below: 7,
                                    borders: "LEFT | RIGHT | BOTTOM",
                                    border_symbols: Rounded,
                                    border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                                    border_title_position: Bottom,
                                    border_title_alignment: Left,
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "1",
                                                pane: Pane(Empty())
                                            ),
                                            (
                                                size: "100%",
                                                // Round 60c (S5): the scrollbar strip's own
                                                // 2-char right margin now sits directly
                                                // against the box border (no 2-col filler to
                                                // its right — the Queue list matches every
                                                // other pane's margin).
                                                pane: Pane(Queue)
                                            ),
                                        ]
                                    )
                                ),
                            ],
                        )
                    ),
                ],
            ),
        ),
        (
            name: "Playlists",
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Playlists), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Downloads",
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Downloads), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "MPD",
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Directories()), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Jellyfin",
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Jellyfin), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        // Round 62 (Q4): there is NO standalone Radio tab anymore — Radio
        // left the Libraries group and lives on the Queue page as the
        // `● Radio` sub-page (see the Queue tab layout above). Any leftover
        // "Radio" tab in an older config is always hidden by the app.
    ],
)
