# ------------------------------------------------------------------- main --

def claim_pid():
    """One daemon per session; exit silently when another is alive."""
    try:
        os.makedirs(CACHE, exist_ok=True)
        if os.path.exists(PID_FILE):
            try:
                with open(PID_FILE) as f:
                    old = int(f.read().strip())
                with open(f"/proc/{old}/cmdline", "rb") as f:
                    cmdline = f.read().decode("utf-8", "replace")
                if "s2u-mpdris" in cmdline:
                    return False
            except Exception:
                pass
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
        return True
    except OSError:
        return True


def release_pid():
    try:
        with open(PID_FILE) as f:
            if f.read().strip() == str(os.getpid()):
                os.remove(PID_FILE)
    except OSError:
        pass


class Logger:
    def __init__(self):
        self.path = os.path.join(CACHE, "mpris.log")

    def __call__(self, message):
        try:
            with open(self.path, "a") as f:
                f.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"),
                                     message))
        except OSError:
            pass


def main():
    if not claim_pid():
        return
    log = Logger()
    try:
        address = os.environ.get("S2U_MPRIS_BUS") or os.environ.get(
            "DBUS_SESSION_BUS_ADDRESS")
        if not address:
            log("no D-Bus session bus (DBUS_SESSION_BUS_ADDRESS unset); "
                "exiting")
            return
        bus = Bus(address)
        # Own the name. 1 = acquired, 4 = already owner.
        for attempt in range(3):
            try:
                result = bus.call(DBUS_IFACE, "/org/freedesktop/DBus",
                                  DBUS_IFACE, "RequestName", "su",
                                  [NAME, 0], reply_sig="u")
            except Exception as err:
                log("RequestName failed: %r" % (err,))
                result = 0
            if result == 1 or result == 4:
                break
            log("bus name %s taken (reply %r); retrying" % (NAME, result))
            time.sleep(1)
        else:
            log("could not acquire %s; exiting" % NAME)
            return

        server = MprisServer(bus, log)
        log("serving %s (%s)" % (NAME, OBJ_PATH))
        while True:
            if not server.tick():
                break
            try:
                for msg in bus.recv(min(POLL_S, 0.5)):
                    kind, _flags, serial, fields, body_sig, values = msg
                    if kind != METHOD_CALL:
                        continue
                    dest = fields.get(FIELD_DESTINATION)
                    if dest and dest != NAME:
                        continue
                    server._req_serial = serial
                    try:
                        server.handle(fields, body_sig, values)
                    except Exception as err:
                        log("method %s failed: %r"
                            % (fields.get(FIELD_MEMBER), err))
            except OSError as err:
                log("bus error: %r" % (err,))
                break
    finally:
        release_pid()


if __name__ == "__main__":
    main()
