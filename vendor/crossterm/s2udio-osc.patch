+/// s2udio patch (round 90): decode one OSC (operating system command)
+/// string.
+///
+/// `buffer` starts with `ESC ]`; the body runs until `ESC \` (the string
+/// terminator) or `BEL`. `Ok(None)` means "not complete yet" — the caller
+/// keeps the bytes and re-parses when the rest arrives, so a sequence split
+/// across reads (or a chunked transfer) still parses. `Err` discards a
+/// runaway sequence instead of buffering without bound.
+fn parse_osc(buffer: &[u8]) -> io::Result<Option<InternalEvent>> {
+    /// A body this long without a terminator is garbage, not a sequence.
+    const MAX_OSC_BODY_LEN: usize = 64 * 1024;
+
+    let body = &buffer[2..];
+    let mut index = 0;
+    while index < body.len() {
+        match body[index] {
+            // BEL-terminated form (`ESC ] <body> BEL`).
+            0x07 => return Ok(Some(osc_event(&body[..index]))),
+            // The proper terminator: `ESC \`.
+            0x1B if body.get(index + 1) == Some(&b'\\') => {
+                return Ok(Some(osc_event(&body[..index])))
+            }
+            _ => index += 1,
+        }
+    }
+    if body.len() > MAX_OSC_BODY_LEN {
+        return Err(could_not_parse_event_error());
+    }
+    Ok(None)
+}
+
+/// Build the [`Event::Osc`] for an already-terminated OSC body (round 90).
+fn osc_event(body: &[u8]) -> InternalEvent {
+    InternalEvent::Event(Event::Osc(body.to_vec()))
+}
