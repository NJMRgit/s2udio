#!/usr/bin/env python3
"""Fetch word-timed lyrics for the currently playing song.

Invoked by rmpc's `on_song_change` hook, which provides these env vars:
  ARTIST, TITLE, ALBUM, DURATION (std Duration Display, e.g. "3m 32s"),
  LRC_FILE (where the colocated .lrc should live), HAS_LRC ("true"/"false"),
  CURRENT_SONG (song file relative to the MPD music root).

Sources (word timing when available):
  * Netease Cloud Music (yrc, per-word ms) - NETEASE_API_URL overrides the
    public instance list.
  * Kugou (krc, per-word ms, XOR-encrypted).
  * LRCLIB (line-level) as fallback.

When a song has word timing from more than one source, each is scored by how
well its timing master matches the actual audio file (duration closeness);
the best match wins - no fixed source priority.

Every file the script writes is stamped with a `# lyric-source-check-v2:`
line. Files that already carry the stamp are never touched again; word-timed
files with an older stamp key (earlier fetches) are re-checked once with the
stricter v2 matching and re-stamped.

v2 matching: every candidate from every source must verify artist, title
and (when known) duration before it is accepted; lyrics that open with a
"Title - Artist" splash naming a different song are rejected.

Log: ~/.local/state/rmpc-fetch-lyrics.log
"""
import base64
import datetime
import gzip
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.parse
import urllib.request

LOG = pathlib.Path.home() / ".local" / "state" / "rmpc-fetch-lyrics.log"
UA = "rmpc-fetch-lyrics/1.0 (rmpc fork by NJMRgit)"
STAMP = "# lyric-source-check-v2:"

NETEASE_INSTANCES = [
    "https://netease-cloud-music-api-eta.vercel.app",
]

# Kugou krc XOR key (16 bytes).
KUGOU_KEY = bytes([0x40, 0x47, 0x61, 0x77, 0x5e, 0x32, 0x74, 0x47,
                   0x51, 0x36, 0x31, 0x2d, 0xce, 0xd2, 0x6e, 0x69])


def log(msg: str) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a", encoding="utf-8") as f:
            f.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")
    except OSError:
        pass


def parse_duration(s: str) -> str:
    """Song duration as seconds. Accepts std Duration Display ('10s',
    '1m 40s') and mm:ss / h:mm:ss ('0:10', '3:45', '1:02:03').
    Returns '' if it cannot be parsed."""
    s = s.strip()
    if not s:
        return ""
    if ":" in s:
        parts = s.split(":")
        if len(parts) == 2:
            h, m, sec = 0, parts[0], parts[1]
        elif len(parts) == 3:
            h, m, sec = parts
        else:
            return ""
        try:
            return str(int(h) * 3600 + int(m) * 60 + float(sec))
        except ValueError:
            return ""
    total = 0.0
    for tok in s.split():
        try:
            if tok.endswith("ms"):
                total += float(tok[:-2]) / 1000.0
            elif tok.endswith("us"):
                total += float(tok[:-2]) / 1_000_000.0
            elif tok.endswith("ns"):
                total += float(tok[:-2]) / 1_000_000_000.0
            elif tok.endswith("s"):
                total += float(tok[:-1])
            elif tok.endswith("m"):
                total += float(tok[:-1]) * 60.0
            elif tok.endswith("h"):
                total += float(tok[:-1]) * 3600.0
            else:
                return ""
        except ValueError:
            return ""
    return f"{total:.0f}" if total > 0 else ""


def get_json(url: str, referer: str | None = None, post: str | None = None):
    headers = {"User-Agent": UA, "Accept-Encoding": "gzip"}
    if referer:
        headers["Referer"] = referer
    req = urllib.request.Request(
        url, headers=headers, data=post.encode() if post else None
    )
    try:
        with urllib.request.urlopen(req, timeout=12) as resp:
            raw = resp.read()
            if resp.headers.get("Content-Encoding") == "gzip":
                raw = gzip.decompress(raw)
            return json.loads(raw)
    except Exception as exc:
        log(f"request failed: {exc}")
        return None


def ms_to_lrc(ms: int) -> str:
    ms = max(0, int(ms))
    m, rem = divmod(ms, 60000)
    s, cs = divmod(rem, 1000)
    return f"{m:02d}:{s:02d}.{cs // 10:02d}"


def norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", "", (s or "").lower())


def match_score(sname: str, tname: str) -> int:
    """0 = unrelated, 1 = contains, 2 = exact. Normalize before calling."""
    if not sname or not tname:
        return 0
    if sname == tname:
        return 2
    if tname in sname or sname in tname:
        return 1
    return 0


def artist_ok(singername: str, aname: str) -> bool:
    """Compatible artists? Unknown on either side passes; a definite mismatch
    rejects. 'Various Artists' tags are not used as a gate."""
    if not aname or aname == "variousartists":
        return True
    if not singername:
        return True
    return singername == aname or aname in singername or singername in aname


# --------------------------------------------------------------------------
# Netease yrc
# --------------------------------------------------------------------------

def netease_instances():
    env = os.environ.get("NETEASE_API_URL", "").strip().rstrip("/")
    return ([env] if env else []) + NETEASE_INSTANCES


def pick_netease_song(songs, artist, title, file_dur):
    """Pick the search result that matches artist + title. Candidates whose
    artist definitely differs from the requested artist are rejected, so a
    same-title cover/remix by someone else can never win. Duration closeness
    breaks ties between versions of the same song."""
    best, best_score = None, -1
    tname, aname = norm(title), norm(artist)
    for s in songs:
        sname = norm(s.get("name"))
        tscore = match_score(sname, tname)
        if tscore == 0:
            continue
        artists = " ".join(a.get("name", "") for a in (s.get("artists") or s.get("ar") or []))
        a = norm(artists)
        if not artist_ok(a, aname):
            continue
        score = tscore * 2  # exact title 4, contained 2
        if aname and a:
            score += 2 if a == aname else 1
        sdur = s.get("duration") or 0
        if file_dur and sdur and abs(sdur / 1000.0 - file_dur) < 4.0:
            score += 2
        if score > best_score:
            best, best_score = s, score
    return best if best_score > 0 else None


def parse_yrc_lines(yrc: str):
    """Netease yrc -> [(line_start_ms, [(word_start_ms, word_text), ...])].
    Skips JSON credit lines and translation duplicates."""
    out, seen = [], set()
    for raw_line in yrc.splitlines():
        line = raw_line.strip()
        m = re.match(r"\[(\d+),(\d+)\](.*)$", line)
        if not m:
            continue  # JSON credit lines etc.
        start_ms = int(m.group(1))
        if start_ms in seen:
            continue  # translation duplicates
        seen.add(start_ms)
        rest = m.group(3)
        # Each (start,dur,flag)text marker owns the text that FOLLOWS it:
        # the word after a marker starts singing at that marker's time.
        words = []  # (start_ms, text)
        prev = start_ms  # text before any marker starts at the line start
        pos = 0
        for wm in re.finditer(r"\((\d+),(\d+),(\d+)\)", rest):
            text = rest[pos:wm.start()].replace("\xa0", " ").strip()
            if text:
                words.append((max(0, prev), text))
            pos = wm.end()
            prev = int(wm.group(1))
        tail = rest[pos:].replace("\xa0", " ").strip()
        if tail and words:
            if tail[0].isalnum():
                # a word after the final marker starts at that marker's time
                words.append((max(0, prev), tail))
            else:
                # trailing punctuation attaches to the previous word
                words[-1] = (words[-1][0], words[-1][1] + tail)
        elif tail:
            words.append((max(0, prev), tail))
        if not words:
            out.append((start_ms, []))
            continue
        out.append((start_ms, words))
    return out


def fetch_netease_lines(artist, title, file_dur):
    """Returns (lines, master_duration_ms) or None."""
    for base in netease_instances():
        try:
            q = urllib.parse.quote(f"{artist} {title}".strip())
            data = get_json(f"{base}/search?keywords={q}&limit=5")
            songs = (data or {}).get("result", {}).get("songs") or []
            if not songs:
                continue
            song = pick_netease_song(songs, artist, title, file_dur)
            if not song:
                continue
            ly = get_json(f"{base}/lyric/new?id={song.get('id')}")
            if not isinstance(ly, dict):
                continue
            yrc = (ly.get("yrc") or {}).get("lyric", "")
            if not yrc:
                log(f"netEase has no word-level lyrics for '{artist}' - '{title}'")
                continue
            lines = parse_yrc_lines(yrc)
            if lines:
                return lines, song.get("duration") or 0
        except Exception as exc:
            log(f"netEase instance {base} failed: {exc}")
    return None


# --------------------------------------------------------------------------
# Kugou krc
# --------------------------------------------------------------------------

def kugou_search(artist, title):
    url = ("http://mobilecdn.kugou.com/api/v3/search/song?format=json&keyword="
           + urllib.parse.quote(f"{artist} {title}".strip())
           + "&page=1&pagesize=8&showtype=1")
    d = get_json(url, referer="http://m.kugou.com/")
    info = (d or {}).get("data", {}).get("info") or []
    return info


def kugou_cand_ok(c, artist, title, file_dur):
    """A krc candidate is only usable when its song/singer/duration line up
    with the requested track, otherwise we may download lyrics for a
    different version or a completely different song."""
    if match_score(norm(c.get("song")), norm(title)) == 0:
        return False
    if not artist_ok(norm(c.get("singer")), norm(artist)):
        return False
    sdur = c.get("duration") or 0
    if file_dur and sdur and abs(float(sdur) / 1000.0 - file_dur) > 4.0:
        return False
    return True


def kugou_download_text(hash_, keyword, artist, title, file_dur):
    """Resolve hash -> verified candidate id/accesskey -> download -> krc."""
    r = get_json(
        "https://lyrics.kugou.com/search?ver=1&man=yes&client=pc&keyword="
        + urllib.parse.quote(keyword) + f"&hash={hash_}",
        referer="https://www.kugou.com/",
    )
    cands = (r or {}).get("candidates") or []
    c = next((c for c in cands if kugou_cand_ok(c, artist, title, file_dur)), None)
    if not c:
        return None
    dl = get_json(
        f"https://lyrics.kugou.com/download?ver=1&client=pc&id={c['id']}"
        f"&accesskey={c.get('accesskey', '')}&fmt=krc&charset=utf8",
        referer="https://www.kugou.com/",
    )
    payload = (dl or {}).get("content", "")
    if not payload:
        return None
    try:
        raw = base64.b64decode(payload)
    except Exception:
        return None
    if len(raw) <= 4:
        return None
    data = bytes(b ^ KUGOU_KEY[i % len(KUGOU_KEY)] for i, b in enumerate(raw[4:]))
    for wbits in (15, -15):
        try:
            return zlib_decompress(data, wbits)
        except Exception:
            continue
    return None


def zlib_decompress(data, wbits):
    import zlib
    return zlib.decompress(data, wbits).decode("utf-8", "replace")


KRC_CREDIT_RE = re.compile(
    r"(lyrics?\s*(by|[:：])|composed?\s*(by|[:：])|written\s*(by|[:：])|"
    r"produced\s*(by|[:：])|mixed\s*(by|[:：])|mastered\s*(by|[:：])|"
    r"recorded\s*(by|[:：])|performed\s*(by|[:：])|"
    r"作词|作曲|编曲|制作|和声|录音|混音|母带)",
    re.IGNORECASE,
)
# Performer credit block ("Maseo/ 2-D：") - only trusted inside the first 2s.
KRC_NAME_CREDIT_RE = re.compile(r"^[\w \-'\\.]+/[\w \-'\\.]*[:：]", re.IGNORECASE)

# "Title - Artist" / "Artist - Title" splash pattern at the track start.
KRC_SPLASH_RE = re.compile(r"^(.+?)\s*[-–—]\s*(.+)$")


def krc_splash_mismatch(krc_text, artist, title):
    """True when the krc opens with a splash naming another song, e.g.
    'Bad Habits (feat. Bring Me The Horizon) - Ed Sheeran' fetched for a
    different BMTH track. Short fragments like 'Woo- ooh' are ignored."""
    n_title, n_artist = norm(title), norm(artist)
    for raw in krc_text.splitlines():
        m = re.match(r"\[(\d+),(\d+)\](.*)$", raw.strip())
        if not m:
            continue
        if int(m.group(1)) >= 3000:
            return False  # past the intro; the rest is real lyrics
        rest = m.group(3).replace("\xa0", " ").strip()
        if not rest:
            continue
        sm = KRC_SPLASH_RE.match(rest)
        if not sm:
            continue
        a_part, b_part = norm(sm.group(1)), norm(sm.group(2))
        if len(a_part) < 6 and len(b_part) < 6:
            continue
        if n_title and (match_score(a_part, n_title) or match_score(b_part, n_title)):
            continue  # the splash names the requested song
        if n_artist and (n_artist in a_part or n_artist in b_part):
            return True  # featured/cover splash for a different song
        if len(a_part) >= 6:
            return True  # splash for an unrelated song
    return False


def parse_krc_lines(krc_text, artist, title):
    """Kugou krc -> [(line_start_ms, [(word_start_ms, word_text), ...])].
    Skips headers, karaoke credit lines and the 'Artist - Title' splash."""
    out = []
    n_artist, n_title = norm(artist), norm(title)
    n_splash = {n_artist + n_title, n_title + n_artist,
                n_artist + "-" + n_title, n_title + "-" + n_artist}
    for raw in krc_text.splitlines():
        m = re.match(r"\[(\d+),(\d+)\](.*)$", raw.strip())
        if not m:
            continue  # [id:...] [ar:...] [language:...] etc.
        start_ms, end_ms = int(m.group(1)), int(m.group(2))
        rest = m.group(3)
        # Each <start,dur,flag> marker owns the text that FOLLOWS it.
        words = []
        prev_off = 0
        pos = 0
        for wm in re.finditer(r"<(\d+),(\d+),(\d+)>", rest):
            text = rest[pos:wm.start()].replace("\xa0", " ").strip()
            if text:
                words.append((start_ms + prev_off, text))
            pos = wm.end()
            prev_off = int(wm.group(1))
        tail = rest[pos:].replace("\xa0", " ").strip()
        if tail and words:
            if tail[0].isalnum():
                words.append((start_ms + prev_off, tail))
            else:
                words[-1] = (words[-1][0], words[-1][1] + tail)
        elif tail:
            words.append((start_ms + prev_off, tail))
        if not words:
            continue

        # Skip the karaoke credits and the opening "Artist - Title" splash.
        text = " ".join(t for _, t in words)
        n_text = norm(text)
        if n_text in n_splash:
            continue
        if KRC_CREDIT_RE.search(text):
            continue
        if start_ms < 2000 and KRC_NAME_CREDIT_RE.search(text):
            continue  # performer credit block
        if start_ms < 1000 and end_ms - start_ms > 5000 and not out:
            continue  # long early splash-like line
        out.append((start_ms, words))
    return out


def fetch_kugou_lines(artist, title, file_dur):
    """Returns (lines, master_duration_ms) or None."""
    try:
        info = kugou_search(artist, title)
        for it in info:
            # Reject hits that are a different version/cover/wrong song
            # before even downloading anything.
            if match_score(norm(it.get("songname")), norm(title)) == 0:
                continue
            if not artist_ok(norm(it.get("singername")), norm(artist)):
                continue
            sdur = it.get("duration") or 0
            if file_dur and sdur and abs(float(sdur) - file_dur) > 4.0:
                continue
            hash_ = it.get("hash")
            if not hash_:
                continue
            text = kugou_download_text(hash_, f"{title} {artist}", artist, title, file_dur)
            if not text:
                continue
            if krc_splash_mismatch(text, artist, title):
                log(f"Kugou krc splash mismatch for '{artist}' - '{title}'; skipping")
                continue
            lines = parse_krc_lines(text, artist, title)
            if len(lines) >= 4:
                mdur = int(it.get("duration") or 0) * 1000
                log(f"Kugou krc -> {len(lines)} timed lines for "
                    f"'{artist}' - '{title}'")
                return lines, mdur
            log(f"Kugou krc too thin ({len(lines)} lines) for "
                f"'{artist}' - '{title}'; skipping")
    except Exception as exc:
        log(f"Kugou fetch failed for '{artist}' - '{title}': {exc}")
    return None


# --------------------------------------------------------------------------
# Enhanced LRC rendering
# --------------------------------------------------------------------------

def render_enhanced(lines, offset_ms: int = 0) -> str:
    out = []
    for start_ms, words in lines:
        start = start_ms + offset_ms
        if not words:
            out.append(f"[{ms_to_lrc(start)}]")
            continue
        parts = [f"[{ms_to_lrc(start)}]"]
        for ws, wt in words:
            parts.append(f"<{ms_to_lrc(ws + offset_ms)}>{wt} ")
        out.append("".join(parts).rstrip())
    return "\n".join(out)


# --------------------------------------------------------------------------
# Audio analysis + alignment
# --------------------------------------------------------------------------

def analyze_audio_silence(audio_path: str, song_duration: float):
    """Measure the actual front/tail silence of the song with ffmpeg's
    silencedetect. Returns (front_silence_s, tail_silence_s), or (0.0, 0.0)
    when the audio cannot be analyzed (callers treat that as 'no info')."""
    try:
        proc = subprocess.run(
            [
                "ffmpeg", "-hide_banner", "-nostats", "-i", audio_path,
                "-af", "silencedetect=noise=-50dB:d=0.25", "-f", "null", "-",
            ],
            capture_output=True, text=True, timeout=180,
        )
    except Exception as exc:
        log(f"silence analysis failed for {audio_path}: {exc}")
        return 0.0, 0.0
    events = [(m.group(1) == "start", float(m.group(2)))
              for m in re.finditer(r"silence_(start|end): ([\d.]+)", proc.stderr)]
    front = 0.0
    if len(events) >= 2 and events[0][0] and events[0][1] < 0.05 and not events[1][0]:
        front = events[1][1]  # file starts with silence -> front gap ends here
    tail = 0.0
    if events and events[-1][1] > song_duration - 1.5:
        last_start = next((t for is_start, t in reversed(events) if is_start), None)
        if last_start is not None:
            tail = max(0.0, song_duration - last_start)
    return round(front, 2), round(tail, 2)


def audio_duration(audio_path: str) -> float:
    """Exact duration of the audio file via ffprobe, or 0.0 on failure."""
    try:
        proc = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", audio_path],
            capture_output=True, text=True, timeout=60,
        )
        return float(proc.stdout.strip())
    except Exception:
        return 0.0


def alignment_offset(song_duration: float, master_duration: float, audio_path: str) -> int:
    """Decide how much to shift the timings (ms) when the file and the timing
    master differ in length. Extra time at the FRONT (longer intro/pregap)
    shifts the timings forward; extra at the TAIL needs no shift."""
    gap = song_duration - master_duration
    if abs(gap) <= 1.5 or abs(gap) > 15:
        return 0
    if gap < 0:
        log(f"file {gap:.1f}s shorter than master ({master_duration:.0f}s); "
            f"no alignment applied")
        return 0
    front, tail = analyze_audio_silence(audio_path, song_duration)
    if front >= 0.5 * gap:
        shift = min(gap, front)
        log(f"front gap detected ({front:.1f}s leading silence, file {gap:.1f}s "
            f"longer than master, tail {tail:.1f}s); shifting timings +{int(shift * 1000)}ms")
        return int(shift * 1000)
    log(f"no front gap (leading silence {front:.1f}s vs gap {gap:.1f}s, tail {tail:.1f}s); "
        f"treating the extra time as outro, no shift")
    return 0


# --------------------------------------------------------------------------
# Stamp + main
# --------------------------------------------------------------------------

def has_stamp(text: str) -> bool:
    return STAMP in (text or "")


def make_stamp(winner: str, scores: dict, file_dur: float) -> str:
    parts = " ".join(f"{k}={v}" for k, v in scores.items())
    return f"{STAMP} winner={winner} ({parts}) file={file_dur:.1f}s"


def save(body: str, out: str, source: str) -> bool:
    try:
        pathlib.Path(out).parent.mkdir(parents=True, exist_ok=True)
        with open(out, "w", encoding="utf-8") as f:
            f.write(body)
        log(f"saved {out} ({len(body)} chars, {source})")
        return True
    except OSError as exc:
        log(f"write failed {out}: {exc}")
        return False


def main() -> int:
    title = os.environ.get("TITLE", "")
    if not title:
        return 0
    out = os.environ.get("LRC_FILE", "") or os.environ.get("LRC_PATH", "")
    if not out:
        return 0

    existing = None
    try:
        if os.path.exists(out):
            with open(out, encoding="utf-8") as f:
                existing = f.read()
    except OSError:
        existing = None

    if existing is not None and has_stamp(existing):
        return 0  # comparison already done for this file
    if existing is not None and "<" not in existing:
        return 0  # not one of our word-timed files (hand-made LRC) - never touch

    artist = os.environ.get("ARTIST", "")
    album = os.environ.get("ALBUM", "")
    duration = parse_duration(os.environ.get("DURATION", ""))

    audio_path = ""
    if out:
        song_rel = os.environ.get("CURRENT_SONG", "")
        if song_rel:
            audio_path = os.path.join(os.path.dirname(out), song_rel)
        else:
            import glob
            stem = re.sub(r"\.lrc$", "", out)
            matches = glob.glob(stem + ".*")
            audio_path = matches[0] if matches else ""
    file_dur = audio_duration(audio_path) or float(duration or 0)

    header = ""
    if artist:
        header += f"[ar:{artist}]\n"
    if title:
        header += f"[ti:{title}]\n"
    if album:
        header += f"[al:{album}]\n"

    # 1) Word-timed sources, scored per track against the actual audio.
    cands = []
    n = fetch_netease_lines(artist, title, file_dur)
    if n:
        lines, mdur = n
        cands.append(("netease", lines, mdur))
    k = fetch_kugou_lines(artist, title, file_dur)
    if k:
        lines, mdur = k
        cands.append(("kugou", lines, mdur))

    scores = {}
    for label, _lines, mdur in cands:
        scores[label] = round(min(10.0, abs(file_dur - (mdur / 1000 if mdur else 0))), 1) \
            if mdur else 5.0

    if cands:
        best = min(cands, key=lambda c: (scores[c[0]], 0 if c[0] == "netease" else 1))
        label, lines, mdur = best
        log(f"source comparison: " + " ".join(f"{k}={v}" for k, v in scores.items())
            + f" -> winner {label}")
        offset = alignment_offset(file_dur, mdur / 1000 if mdur else file_dur, audio_path) \
            if mdur else 0
        body = header + "\n" + render_enhanced(lines, offset) + "\n"
        body = make_stamp(label, scores, file_dur) + "\n" + body
        tag = f"{label} word-level" + (f", aligned +{offset}ms" if offset else "")
        save(body, out, tag)
        return 0

    # 2) LRCLIB fallback (line-level synced).
    exact = {"artist_name": artist, "track_name": title}
    if album:
        exact["album_name"] = album
    if duration:
        exact["duration"] = duration

    data = get_json("https://lrclib.net/api/get?" + urllib.parse.urlencode(exact))
    if not isinstance(data, dict) or not data.get("syncedLyrics"):
        fuzzy = {"artist_name": artist, "track_name": title}
        hits = get_json("https://lrclib.net/api/search?" + urllib.parse.urlencode(fuzzy))
        if isinstance(hits, list):
            n_artist, n_title = norm(artist), norm(title)
            data = next(
                (e for e in hits
                 if e.get("syncedLyrics")
                 and not e.get("instrumental")
                 and match_score(norm(e.get("trackName")), n_title) > 0
                 and artist_ok(norm(e.get("artistName")), n_artist)),
                None,
            )

    if isinstance(data, dict) and not data.get("instrumental"):
        synced = data.get("syncedLyrics")
        if synced:
            body = header + "\n" + synced.strip() + "\n"
            body = make_stamp("lrclib", scores, file_dur) + "\n" + body
            save(body, out, f"LRCLIB synced, id={data.get('id')}")
            return 0

    # 3) Nothing found: keep an old word-timed file but mark it as checked.
    if existing is not None:
        body = make_stamp("none", scores, file_dur) + "\n" + existing
        save(body, out, "no source found; kept existing, stamped")
        return 0

    log(f"no lyrics found for '{artist}' - '{title}'")
    return 0


if __name__ == "__main__":
    sys.exit(main())
