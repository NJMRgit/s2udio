method. (dbus.service.method\n            # returns the plain function with _dbus_* attrs — there is no\n            # `.func` to wrap in this dbus-python version.)\n            guarded.__dict__.update(\n                {k: v for k, v in _orig.__dict__.items()\n                 if k.startswith("_dbus_")})\n            setattr(iface, name, guarded)\n            patched = True\n    return patched\n\n\ndef main():\n    path = _find_official()\n    if not path:\n        sys.stderr.write("s2u-mpdris2: official mpDris2 not found\\n")\n        return 1\n    try:\n        with open(path, encoding="utf-8") as f:\n            source = f.read()\n    except OSError as err:\n        sys.stderr.write("s2u-mpdris2: cannot read %s: %r\\n" % (path, err))\n        return 1\n\n    # Load the module with the __main__ guard skipped (classes defined,\n    # main body deferred). /usr/bin/mpDris2 has no .py suffix, so the\n    # source loader must be named explicitly.\n    import importlib.machinery\n    loader = importlib.machinery.SourceFileLoader("mpdris2_official", path)\n    spec = importlib.util.spec_from_loader("mpdris2_official", loader)\n    mod = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = mod\n    loader.exec_module(mod)\n\n    # Extend the loaded official module with the s2udio stream-art /\n    # metadata / seek-hardening patches (version-guarded inside).\n    patched = _patch_mpdris2(mod)\n\n    # Run the official main body (the code under `if __name__ == \'__main__\':`).\n    idx = source.find(MARKER)\n    if idx == -1:\n        sys.stderr.write("s2u-mpdris2: unexpected mpDris2 layout "\n                         "(no __main__ guard); aborting\\n")\n        return 1\n    body = source[idx + len(MARKER):]\n    import textwrap\n    body = textwrap.dedent(body)\n    if patched:\n        sys.stderr.write("s2u-mpdris2: stream-art extension active (%s)\\n" % path)\n    else:\n        sys.stderr.write("s2u-mpdris2: mpDris2 layout changed; running "\n                         "unpatched (no stream art)\\n")\n    exec(compile(body, path, "exec"), mod.__dict__)\n    return 0  # unreachable while the GLib loop runs\n\n\nif __name__ == "__main__":\n    sys.exit(main())\n',
    'svc': '#!/usr/bin/env bash\n# s2u-svc <start|stop|restart|enable|is-active|backend> <svc> [--user]\n#\n# Service-manager abstraction for s2udio (plan docs/design/Validation/\n# distro-support.md §6.1). Setup, the tracker and docs call this instead of\n# hardcoding `systemctl --user`. Backends:\n#\n#   systemd-user   systemctl --user works        -> systemctl --user …\n#   runit-user     runsvdir + ~/.config/runit    -> sv start/stop/restart/status\n#   s6-user        s6-svscan + ~/.config/s6      -> s6-svc -u/-d/-r\n#   openrc         /sbin/openrc-run              -> rc-service … (root-level)\n#   sysvinit       /etc/init.d/<svc>             -> service … start|stop\n#   launcher       anything else                 -> plain user processes\n#                                                  (mpd / s2u-mpdris2 shim),\n#                                                  pidfiles under\n#                                                  ~/.cache/s2udio/svc/\n#\n# v1 (Phase 1): systemd-user + plain-launcher are implemented and tested\n# (gate G11). runit-user / s6-user / openrc / sysvinit backends land with\n# the Phase 3 non-systemd workstream.\n#\n# `svc` may be given with or without the .service/.run suffix (mpd,\n# mpDris2.service, …). Exit status mirrors systemctl: 0 = active/ok.\nset -euo pipefail\n\n# ---------------------------------------------------------------------------\ndetect_backend() {\n    # systemd-user: a REAL user manager answers. Containers without logind\n    # make systemctl print "offline" with rc=0 — that must not count.\n    local st\n    st="$(systemctl --user is-system-running 2>/dev/null || true)"\n    case "$st" in\n        running|degraded|starting|maintenance|stopping)\n            echo systemd-user; return ;;\n    esac\n    # runit-user: per-user runsvdir under ~/.config/runit with live sv sockets\n    if command -v sv >/dev/null 2>&1 && [[ -d "$HOME/.config/runit" ]] \\\n       && ls "$HOME/.config/runit/" | grep -q . 2>/dev/null; th