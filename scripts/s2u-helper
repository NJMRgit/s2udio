 (audio wins), show the\n            # MPD entry again. Runs every tick so play/pause flips are\n            # followed; s2u-svc only on a change.\n            want_mpdris2 = bool(st["paused"]) and mpd_state() == "play"\n            if want_mpdris2 != mpdris2_want:\n                mpdris2("start" if want_mpdris2 else "stop")\n                mpdris2_want = want_mpdris2\n            # Keep the mpv MPRIS bridge alive while a video session exists\n            # (respawn at most every 30 s; the bridge exits itself when the\n            # state file goes stale).\n            if time.time() - last_bridge >= 30:\n                spawn_mpris_bridge()\n                last_bridge = time.time()\n            last_position = st["position"]\n            item_id = item_id_from_url(st["path"])\n\n            if s2u_running():\n                # s2udio owns the state file, the Jellyfin tracking and the\n                # MPD<->mpv mutual exclusion; arm the latches again so the\n                # first caretaker tick after its exit initializes fresh.\n                mpd_latch["armed"] = False\n                continue\n\n            # ---- caretaker mode: s2udio is closed, take over -------------\n            # Mutual exclusion: the video and the music never play at the\n            # same time. Which one pauses depends on which started last:\n            #   - MPD starts playing while the video plays -> pause mpv\n            #   - the video resumes while MPD plays       -> pause MPD\n            # Latches are armed on the first caretaker tick (and re-armed\n            # after s2udio ran), so a pre-existing "both playing" state is\n            # not mistaken for a fresh start.\n            mpv_playing = not st["paused"]\n            if not mpd_latch["armed"]:\n                mpd_latch = {"state": mpd_state(), "mpv_playing": mpv_playing,\n                             "armed": True}\n                # Restore the invariant if a race left both playing (the\n                # video pauses; MPD keeps its music).\n                if mpd_latch["state"] == "play" and mpv_playing:\n                    log("both playing at caretaker takeover; pausing mpv")\n                    mpv_command(sock, ["set_property", "pause", True])\n            else:\n                mpd_state_now = mpd_state()\n                if mpd_state_now == "play" and mpv_playing \\\n                        and mpd_latch["state"] != "play":\n                    log("MPD started playing; pausing mpv")\n                    mpv_command(sock, ["set_property", "pause", True])\n                if mpv_playing and mpd_state_now == "play" \\\n                        and mpd_latch["mpv_playing"] is False:\n                    log("mpv resumed while MPD plays; pausing MPD")\n                    mpd_pause()\n                mpd_latch["state"] = mpd_state_now\n            mpd_latch["mpv_playing"] = mpv_playing\n\n            if item_id != item["id"]:\n                item = {"id": item_id, "meta": None, "poster": False,\n                        "resume": 0.0, "resume_applied": False}\n            if jf is None:\n                jf = load_jellyfin()  # retry in case the config appeared\n\n            if item_id and jf:\n                if item["meta"] is None:\n                    try:\n                        item["meta"] = jf_item_meta(jf, item_id)\n                        item["poster"] = jf_write_poster(jf, item_id)\n                        item["resume"] = jf_fetch_resume(jf, item_id)\n                    except Exception as err:\n                        log("Jellyfin item fetch failed: %r" % (err,))\n                        item["meta"] = (None, None)\n                if (not item["resume_applied"] and item["resume"] > 10\n                        and st["duration"] > 0\n                        and st["position"] < item["resume"] - 5):\n                    mpv_command(sock, ["set_property", "time-pos",\n                                       item["resume"]])\n                    item["resume_applied"] = True\n                    st["position"] = item["resume"]\n\n            if item_id and item["meta"] and item["meta"][0]:\n                title, artist = item["meta"]\n            else:\n                title = st["media_title"]\n                if is_provisional(title):\n                    # mpv has no real title yet (URL / `index.m3u8`\n                    # basename): prefer the cached resolved info (title +\n                    # channel), then the playlist entry\'s saved title, and\n                    # only then the previous title.\n                    title, artist = last_title, last_artist\n                    url = st.get("path") or ""\n                    yt = load_yt_info(url)\n                    if yt and yt.get("title"):\n                        title = yt["title"]\n                        if yt.get("channel"):\n                            artist = yt["channel"]\n                    else:\n                        pl_title = _entry_title(st, url)\n                        if pl_title and pl_title != url:\n                            title = pl_title\n                            artist = ""\n                else:\n                    artist = ""\n            last_title, last_artist = title, artist\n\n            now = time.time()\n            if item_id and jf and (\n                    now - last_progress >= PROGRESS_EVERY_S\n                    or st["paused"] != last_paused):\n                try:\n                    jf_report_progress(jf, item_id, st["position"],\n                                       st["paused"])\n                except Exception as err:\n                    log("Jellyfin progress failed: %r" % (err,))\n                last_progress = now\n            last_paused = st["paused"]\n\n            # Duration: mpv may report 0/unavailable for DASH/HLS streams\n            # (the desktop widget then drops the timeline + seeking). The\n            # yt-info cache carries the real duration — fall back to it.\n            duration = st.get("duration") or 0\n            cur_url = st.get("path") or ""\n            if not duration:\n                yt = load_yt_info(cur_url)\n                if yt and yt.get("duration"):\n                    duration = yt["duration"]\n            playlist = []\n            for e in st["playlist"]:\n                p_url = e.get("filename") or ""\n                # NB: local vars — the caretaker\'s `title`/`artist` (the\n                # playing item\'s name) must survive this loop for the\n                # write below; shadowing them broke MPRIS titles in\n                # caretaker mode ("stream" instead of the episode name).\n                p_title = e.get("title") or display_title(p_url)\n                p_duration = e.get("duration")\n                original = None\n                if p_url:\n                    yt = load_yt_info(p_url)\n                    if yt and yt.get("original_url"):\n                        original = yt["original_url"]\n                        # mpv\'s title for a resolved stream is often the URL\n                        # basename; the cache has the real title.\n                        if not e.get("title") and yt.get("title"):\n                            p_title = yt["title"]\n                        if not p_duration and yt.get("duration"):\n                            p_duration = yt["duration"]\n                playlist.append({\n                    "title": p_title,\n                    "url": p_url,\n                    "duration": p_duration,\n                    "original_url": original,\n                })\n            write_state({\n                "title": title,\n                "artist": artist,\n                "art": POSTER if os.path.exists(POSTER) else "",\n                "paused": st["paused"],\n                "position": st["position"],\n                "duration": duration,\n                "socket": sock,\n                "item_id": item_id,\n                "volume": st["volume"],\n                "playlist": playlist,\n                "playlist_pos": st["playlist_pos"],\n            })\n\n        # ---- mpv is gone ----\n        if not s2u_running():\n            if jf and item.get("id"):\n                try:\n                    jf_report_stopped(jf, item["id"], last_position)\n                except Exception:\n                    pass\n            delete_state()\n    finally:\n        mpdris2("start")  # audio MPRIS returns once the video session is over\n        release_pid()\n\n\ndef log(message):\n    try:\n        with open(os.path.join(CACHE, "mpv-tracker.log"), "a") as f:\n            f.write(f"{time.strftime(\'%Y-%m-%dT%H:%M:%S\')} {message}\\n")\n    except OSError:\n        pass\n\n\nif __name__ == "__main__":\n    main()\n',
    'mpris': '#!/usr/bin/env python3\n"""MPRIS bridge for s2udio\'s mpv session (Jellyfin video playback).\n\ns2udio writes ~/.cache/s2udio/mpv-mpris.json every ~500 ms while mpv plays;\nthis daemon exposes it as org.mpris.MediaPlayer2.s2udio so desktop media\ncontrols show the episode/movie title + poster and can pause/seek the video\n(controls are routed to mpv\'s IPC socket, whose path is in the state file).\n\nExits when the state file disappears or goes stale (s2udio died).\n"""\nimport json\nimport os\nimport socket\nimport sys\nimport time\n\nimport dbus\nimport dbus.service\nfrom dbus.mainloop.glib import DBusGMainLoop\nfrom gi.repository import GLib\n\n# Round 19: s2udio cache default moved to ~/.cache/s2udio (legacy\n# ~/.cache/rmpc honored for migration via S2U_CACHE_DIR).\nSTATE = os.path.expanduser(os.environ.get("S2U_CACHE_DIR", "~/.cache/s2udio") + "/mpv-mpris.json")\nINTERFACE = "org.mpris.MediaPlayer2"\n# The bus name stays the player\'s discovery name (org.mpris.MediaPlayer2.*);\n# the INTERFACE constant is the standard root interface of the MPRIS spec.\nBUS_NAME = "org.mpris.MediaPlayer2.s2udio"\nPLAYER = "org.mpris.MediaPlayer2.Player"\n\n_last_sig = None  # (title, artist, art, playing) fingerprint of the last emission\n_last_position = None\n_last_touch = time.time()\n\n# Round 68 (host-validated 2026-09-08): the bridge otherwise emits nothing\n# during steady playback (no fingerprint change, no >2 s position jump), so\n# the desktop widget freezes on the last advertised state until the user\n# pauses/resumes (play/pause flips the fingerprint). A Seeked on every 1 s\n# advance plus a periodic PropertiesChanged while playing keep the media\n# controls live (title, timeline, seek bar).\nHEARTBEAT_S = 15\n\n\ndef read_state():\n    try:\n        with open(STATE) as f:\n            return json.load(f)\n    except Exception:\n        return None\n\n\ndef mpv_command(command):\n    st = read_state() or {}\n    path = st.get("socket") or ""\n    if not path:\n        return\n    try:\n        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n        s.settimeout(1)\n        s.connect(path)\n        s.sendall((json.dumps({"command": command}) + "\\n").encode())\n        s.close()\n    except Exception:\n        pass\n\n\nDBusGMainLoop(set_as_default=True)\nbus = dbus.SessionBus()\n\n\ndef _art_url(path):\n    """file:// URL for the mpv poster, cache-busted by mtime.\n\n    The poster is rewritten in place on every entry change; MPRIS clients\n    (KDE media controls) cache album art by URL, so a stable path would\n    keep showing the previous video\'s thumbnail (e.g. a Jellyfin episode\n    after a YouTube video). The mtime query makes the URL change whenever\n    the file changes, forcing media controls to re-fetch it.\n    """\n    try:\n        mtime = os.stat(path).st_mtime_ns\n    except OSError:\n        mtime = 0\n    return "file://%s?t=%d" % (path, mtime)\n\n\nclass S2udioMpris(dbus.service.Object):\n    def __init__(self):\n        # The MPRIS spec mandates the root object at /org/mpris/MediaPlayer2\n        # for every player (clients introspect that path, e.g. KDE\'s media\n        # controller). The bus name org.mpris.MediaPlayer2.s2udio already\n        # disambiguates us from mpDris2\'s org.mpris.MediaPlayer2.mpd.\n        super().__init__(bus, "/org/mpris/MediaPlayer2")\n\n    # ---- helpers ---------------------------------------------------------\n    def _meta(self):\n        st = read_state() or {}\n        title = st.get("title") or "s2udio"\n        artist = st.get("artist") or ""\n        art = st.get("art") or ""\n        duration = dbus.Int64(int((st.get("duration") or 0) * 1_000_000))\n        meta = dbus.Dictionary(\n            {\n                "mpris:trackid": dbus.ObjectPath("/org/mpris/MediaPlayer2/s2udio/Track/0"),\n                "mpris:length": duration,\n                "xesam:title": title,\n            },\n            signature="sv",\n        )\n        if artist:\n            meta["xesam:artist"] = [artist]\n        if art:\n            meta["mpris:artUrl"] = _art_url(art)\n        return meta\n\n    def _status(self):\n        st = read_state() or {}\n        return "Playing" if st.get("playing", False) else "Paused"\n\n    def _position(self):\n        st = read_state() or {}\n        return dbus.Int64(int((st.get("position") or 0) * 1_000_000))\n\n    # ---- org.mpris.MediaPlayer2 ------------------------------------------\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="s")\n    def Identity(self):\n        return "s2udio (mpv)"\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="s")\n    def DesktopEntry(self):\n        return "s2udio"\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="b")\n    def CanQuit(self):\n        return False\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="b")\n    def CanRaise(self):\n        return False\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="b")\n    def CanSetFullscreen(self):\n        return False\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="b")\n    def HasTrackList(self):\n        return False\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="b")\n    def Fullscreen(self):\n        return False\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="")\n    def Quit(self):\n        pass\n\n    @dbus.service.method(INTERFACE, in_signature="", out_signature="")\n    def Raise(self):\n        pass\n\n    # ---- org.mpris.MediaPlayer2.Player -----------------------------------\n    @dbus.service.method(PLAYER, in_signature="", out_signature="s")\n    def PlaybackStatus(self):\n        return self._status()\n\n    @dbus.service.method(PLAYER, in_signature="", out_signature="a{sv}")\n    def Metadata(self):\n        return self._meta()\n\n    @dbus.service.method(PLAYER, in_signature="", out_signature="x")\n    def Position