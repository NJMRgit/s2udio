#!/usr/bin/env python3
# s2u-helper - one executable for every s2udio helper program (round 70).
#
# Subcommands:
#   tracker       caretaker daemon: keeps the MPRIS state file + Jellyfin
#                 tracking alive when s2udio closes while a video plays
#   mpris         MPRIS bridge for the mpv session (org.mpris.MediaPlayer2
#                 .s2udio) - desktop media controls for the video
#   mpdris2       shim that runs the official mpDris2 with the stream-art /
#                 notification / seek-hardening extensions
#   svc           service-manager abstraction (systemd-user, runit-user,
#                 s6-user, openrc, sysvinit, plain-launcher backends)
#   bgutil-renew  randomized pre-expiry restart of the s2u-yt PO-token
#                 minter (12 h cliff)
#
# The five source programs are embedded below (regenerate with
# `python3 scripts/dev/build-helper.py` after editing any of them); each
# runs in its own namespace so name clashes cannot happen.
import os
import sys

_SOURCES = {
    'tracker': '#!/usr/bin/env python3\n"""Track s2udio\'s mpv session independently of the app.\n\ns2udio launches mpv for video (Jellyfin / YouTube / local files) and spawns\nthis daemon alongside it. While s2udio is running its own poll owns the\nMPRIS state file, the Jellyfin tracking and the MPD<->mpv mutual exclusion;\nthis daemon idles. When s2udio closes, the daemon takes over within a\nsecond:\n\n- keeps ~/.cache/rmpc/mpv-mpris.json fresh and starts the bundled\n  s2udio-mpris daemon, so the video stays on the desktop media controls\n  (title/poster, and control through mpv\'s IPC socket),\n- for a Jellyfin item (the current mpv URL is a /Videos/<id>/stream URL):\n  fetches the item name/artist + poster (written to mpris-mpv-art),\n  applies the saved resume position once, reports playback progress every\n  ~10s and the stop-with-position when mpv exits, so the server\'s resume\n  position and web session stay correct,\n- enforces the mutual exclusion between mpv and MPD while s2udio is\n  closed: MPD starting to play pauses a playing video, and a video\n  resuming (e.g. from the desktop media controls) while MPD plays pauses\n  the music — the two never play at the same time,\n- hides the MPD audio MPRIS while a video session is alive: stops the\n  mpDris2.service (mpdris2 MPRIS) on session start and restarts it when\n  mpv exits, so desktop media controls show only the video (s2udio-mpris)\n  during playback instead of the paused MPD audio,\n- on mpv exit: reports the stop (Jellyfin only, when s2udio is not running)\n  and deletes the state file so the MPRIS bridge exits.\n\ns2udio re-reads the state file on startup to reattach to a still-playing\nvideo (controls, seekbar, album art and MPRIS resume working again).\n\nExits when mpv exits. Python stdlib only.\n\nEnv overrides (also used by tests):\n  S2U_MPV_SOCKET        - use this exact mpv IPC socket path\n  S2U_FORCE_CARETAKER=1 - act as the caretaker even while s2udio runs\n  S2U_JELLYFIN_CONFIG   - Jellyfin credentials file to read instead of\n                          ~/.config/rmpc/jellyfin.ron / jellytui\'s\n  S2U_CACHE_DIR         - cache dir for the state/poster/pid files instead\n                          of ~/.cache/rmpc\n  S2U_MPD_HOST          - MPD host to watch (else MPD_HOST, else the\n                          address: in ~/.config/rmpc/config.ron, else\n                          127.0.0.1)\n  S2U_MPD_PORT          - MPD port (else MPD_PORT, else the config, else\n                          6600)\n  S2U_MPD_PASSWORD      - MPD password (else MPD_PASSWORD, else the\n                          password: in ~/.config/rmpc/config.ron)\n  S2U_POLL_S            - poll interval in seconds (default 1.0; tests use\n                          0.3)\n"""\nimport json\nimport os\nimport re\nimport socket\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\ndef _cache_dir():\n    # Round 19: s2udio-only cache files default to ~/.cache/s2udio; the\n    # pre-round-19 ~/.cache/rmpc location is honored when it still holds\n    # the state (migration).\n    env = os.environ.get("S2U_CACHE_DIR")\n    if env:\n        return env\n    new = os.path.expanduser("~/.cache/s2udio")\n    legacy = os.path.expanduser("~/.cache/rmpc")\n    if os.path.exists(os.path.join(new, "mpv-mpris.json")) or os.path.exists(new):\n        return new\n    if os.path.exists(os.path.join(legacy, "mpv-mpris.json")):\n        return legacy\n    return new\n\nCACHE = _cache_dir()\nSTATE = os.path.join(CACHE, "mpv-mpris.json")\nPOSTER = os.path.join(CACHE, "mpris-mpv-art")\nPID_FILE = os.path.join(CACHE, "mpv-tracker.pid")\nFIXED_SOCKET = "/tmp/mpvsocket"  # SVP4\'s socket; s2udio launches mpv with it\nMPV_SOCKETS_DIR = "/tmp/mpvSockets"  # legacy mpvSockets.lua per-instance sockets\n\nPOLL_S = float(os.environ.get("S2U_POLL_S") or 1.0)\nPROGRESS_EVERY_S = 10.0\n# Consecutive failed socket reads before assuming mpv exited.\nDEAD_LIMIT = 5\n# The state file is trusted for reattach only while this fresh.\nFRESH_S = 15\n\n_CONFIG_RE = re.compile(r\'(server_url|access_token|user_id)\\s*[:=]\\s*"([^"]*)"\')\n_ADDRESS_RE = re.compile(r\'address\\s*:\\s*"([^"]+)"\')\n_PROVISIONAL = ("http://", "https://", "www.", "watch?v=", "youtu.be/",\n                "youtube.com/", "soundcloud.com/", "nicovideo.jp/")\n# Stream basenames mpv falls back to for resolved audio URLs (e.g.\n# `index.m3u8`) — never real titles.\n_STREAM_EXTS = ("m3u8", "m3u", "m4a", "mp3", "aac", "opus", "flac",\n                "ogg", "webm")\n\n\n# ---------------------------------------------------------------- helpers --\n\ndef s2u_running():\n    """True while s2udio itself is running (its poll owns MPRIS + Jellyfin\n    + the MPD<->mpv mutual exclusion)."""\n    if os.environ.get("S2U_FORCE_CARETAKER") == "1":\n        return False\n    try:\n        # The installed binary runs as `s2udio` (setup.sh renames the\n        # release build); pgrep must match it too or the tracker thinks\n        # s2udio is closed and acts as caretaker while the TUI runs.\n        for name in ("s2u", "rmpc", "s2udio"):\n            r = subprocess.run(["pgrep", "-x", name],\n                               stdout=subprocess.DEVNULL,\n                               stderr=subprocess.DEVNULL, timeout=3)\n            if r.returncode == 0:\n                return True\n    except Exception:\n        pass\n    return False\n\n\ndef _socket_live(path):\n    """True when a Unix socket accepts connections (mpv\'s IPC is live).\n    A stale file left by a crashed mpv is refused, so this is the check\n    that keeps the fixed /tmp/mpvsocket (SVP4\'s socket) authoritative."""\n    try:\n        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n        s.settimeout(0.5)\n        s.connect(path)\n        s.close()\n        return True\n    except OSError:\n        return False\n\n\ndef mpv_socket():\n    """The fixed /tmp/mpvsocket when live (SVP4\'s socket, and the one\n    s2udio passes on launch); else the newest socket under\n    /tmp/mpvSockets (legacy mpvSockets.lua); else the fixed path even when\n    stale so callers can detect the dead socket. Mirrors s2udio\'s\n    `mpv_socket()`."""\n    override = os.environ.get("S2U_MPV_SOCKET")\n    if override:\n        return override if os.path.exists(override) else None\n    if _socket_live(FIXED_SOCKET):\n        return FIXED_SOCKET\n    best = None\n    try:\n        for name in os.listdir(MPV_SOCKETS_DIR):\n            p = os.path.join(MPV_SOCKETS_DIR, name)\n            # mpvSockets.lua\'s per-instance sockets are Unix-domain\n            # sockets; os.path.isfile() is False for them, so match the\n            # Rust side and accept any entry in the dir.\n            if not os.path.exists(p):\n                continue\n            mtime = os.path.getmtime(p)\n            if best is None or mtime > best[1]:\n                best = (p, mtime)\n    except OSError:\n        pass\n    if best:\n        return best[0]\n    return FIXED_SOCKET if os.path.exists(FIXED_SOCKET) else None\n\n\ndef mpv_exchange(sock_path, commands):\n    """Send one JSON line per command; return the parsed responses in order.\n    None when mpv cannot be reached at all."""\n    try:\n        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n        s.settimeout(2)\n        s.connect(sock_path)\n        for command in commands:\n            s.sendall((json.dumps({"command": command}) + "\\n").encode())\n        f = s.makefile("rb")\n        responses = []\n        for _ in commands:\n            line = f.readline()\n            if not line:\n                break\n            try:\n                responses.append(json.loads(line))\n            except ValueError:\n                pass\n        f.close()\n        s.close()\n        return responses or None\n    except OSError:\n        return None\n\n\ndef read_mpv_state(sock_path):\n    """dict of mpv\'s playback state, or None when mpv is unreachable."""\n    responses = mpv_exchange(sock_path, [\n        ["get_property", "time-pos"],\n        ["get_property", "pause"],\n        ["get_property", "duration"],\n        ["get_property", "volume"],\n        ["get_property", "playlist-pos"],\n        ["get_property", "playlist-count"],\n        ["get_property", "media-title"],\n        ["get_property", "path"],\n        ["get_property", "playlist"],\n    ])\n    if responses is None:\n        return None\n\n    def value(i, default=None):\n        if i < len(responses) and responses[i].get("error") == "success":\n            return responses[i].get("data", default)\n        return default\n\n    playlist = value(8) or []\n    playlist_pos = value(4)\n    for i, entry in enumerate(playlist):\n        if entry.get("current") or entry.get("playing"):\n            playlist_pos = i\n            break\n    return {\n        "position": float(value(0) or 0),\n        "paused": bool(value(1) or False),\n        "duration": float(value(2) or 0),\n        "volume": int(value(3) or 0),\n        "playlist_pos": playlist_pos,\n        "playlist_count": value(5),\n        "media_title": value(6) or "",\n        "path": value(7) or "",\n        "playlist": playlist,\n    }\n\n\ndef mpv_command(sock_path, command):\n    """Fire-and-forget mpv command."""\n    try:\n        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n        s.settimeout(2)\n        s.connect(sock_path)\n        s.sendall((json.dumps({"command": command}) + "\\n").encode())\n        s.close()\n    except OSError:\n        pass\n\n\ndef item_id_from_url(url):\n    """Jellyfin item id from a `{base}/Videos/{id}/stream` URL (32 hex)."""\n    try:\n        from urllib.parse import urlparse\n        segments = [s for s in urlparse(url).path.split("/") if s]\n        if (len(segments) >= 2 and segments[0] in ("Audio", "Videos")\n                and len(segments[1]) == 32):\n            return segments[1]\n    except Exception:\n        pass\n    return None\n\n\ndef load_yt_info(url):\n    """The cached resolved info for `url` (keyed by the stream URL or the\n    canonical link), or None. Mirrors s2udio\'s yt-info.json sidecar."""\n    try:\n        with open(os.path.join(CACHE, "yt-info.json"), encoding="utf-8") as f:\n            cache = json.load(f)\n    except (OSError, ValueError):\n        return None\n    if url in cache:\n        return cache[url]\n    for entry in cache.values():\n        if isinstance(entry, dict) and entry.get("original_url") == url:\n            return entry\n    return None\n\n\ndef _entry_title(st, url):\n    """The saved playlist entry title for the playing URL, or None."""\n    for e in st.get("playlist") or []:\n        if isinstance(e, dict) and e.get("url") == url and e.get("title"):\n            return e["title"]\n    return None\n\n\ndef display_title(url):\n    name = url.rsplit("/", 1)[-1].split("?", 1)[0]\n    return name or url\n\n\ndef is_provisional(title):\n    t = title.strip()\n    if (t.startswith(("http://", "https://", "www."))\n            or any(k in t for k in _PROVISIONAL[3:])):\n        return True\n    # A bare stream basename (`index.m3u8`) is not a real title either.\n    if (t and "/" not in t and "\\\\" not in t and " " not in t\n            and "." in t and t.rsplit(".", 1)[-1] in _STREAM_EXTS):\n        return True\n    return False\n\n\ndef _config_candidates():\n    """The s2udio config file(s): round-23 ~/.config/s2udio/config.ron\n    first, then the legacy ~/.config/rmpc/config.ron."""\n    return [\n        os.path.expanduser("~/.config/s2udio/config.ron"),\n        os.path.expanduser("~/.config/rmpc/config.ron"),\n    ]\n\n\n# ------------------------------------------------------------------- MPD --\n\ndef mpd_addr():\n    """(host, port) of the MPD server. Test env, then the standard\n    MPD_HOST/MPD_PORT, then the address: in ~/.config/s2udio/config.ron\n    (round 23; legacy ~/.config/rmpc honored), then the MPD default."""\n    host = os.environ.get("S2U_MPD_HOST") or os.environ.get("MPD_HOST")\n    port = os.environ.get("S2U_MPD_PORT") or os.environ.get("MPD_PORT")\n    if host is None or port is None:\n        for cfg in _config_candidates():\n            try:\n                with open(cfg) as f:\n                    content = f.read()\n            except OSError:\n                continue\n            m = _ADDRESS_RE.search(content)\n            if not m:\n                continue\n            addr = m.group(1)\n            if ":" in addr:\n                h, p = addr.rsplit(":", 1)\n                if host is None:\n                    host = h\n                if port is None:\n                    port = p\n            elif host is None:\n                host = addr\n            if host is not None and port is not None:\n                break\n    if host is None:\n        host = "127.0.0.1"\n    if port is None:\n        port = "6600"\n    try:\n        return host, int(port)\n    except ValueError:\n        return host, 6600\n\n\ndef mpd_connect():\n    """A socket to MPD (TCP, or a unix socket when the host starts with\n    \'/\'), or None when unreachable."""\n    host, port = mpd_addr()\n    try:\n        if host.startswith("/"):\n            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n            s.settimeout(2)\n            s.connect(host)\n        else:\n            s = socket.create_connection((host, port), timeout=2)\n        return s\n    except OSError:\n        return None\n\n\ndef mpd_password():\n    """MPD password: env override, then the rmpc config\'s `password:`."""\n    pw = os.environ.get("S2U_MPD_PASSWORD", os.environ.get("MPD_PASSWORD"))\n    if pw:\n        return pw\n    for cfg in _config_candidates():\n        try:\n            with open(cfg) as f:\n                content = f.read()\n        except OSError:\n            continue\n        m = re.search(r\'password\\s*:\\s*"([^"]*)"\', content)\n        if m:\n            return m.group(1)\n    return None\n\n\ndef mpd_exchange(commands):\n    """Send command lines to MPD; return one list of response lines per\n    command (the MPD greeting and auth response are consumed, not\n    returned). None when MPD cannot be reached at all."""\n    s = mpd_connect()\n    if s is None:\n        return None\n    try:\n        f = s.makefile("rb")\n        pw = mpd_password()\n        if pw:\n            s.sendall(("password " + pw + "\\n").encode())\n            while True:\n                line = f.readline()\n                if not line:\n                    break\n                if line == b"OK\\n" or line.startswith(b"ACK"):\n                    break\n        responses = []\n        for command in commands:\n            s.sendall((command + "\\n").encode())\n            lines = []\n            while True:\n                line = f.readline()\n                if not line:\n                    break\n                if line == b"OK\\n" or line.startswith(b"ACK"):\n                    break\n                lines.append(line.decode(errors="replace").strip())\n            responses.append(lines)\n        f.close()\n        s.close()\n        return responses\n    except OSError:\n        try:\n            s.close()\n        except OSError:\n            pass\n        return None\n\n\ndef mpd_state():\n    """MPD playback state: \'play\'/\'pause\'/\'stop\', or None when the server\n    cannot be reached at all."""\n    responses = mpd_exchange(["status"])\n    if not responses or not responses[0]:\n        return None\n    for line in responses[0]:\n        if line.startswith("state: "):\n            return line[len("state: "):]\n    return None\n\n\ndef mpd_pause():\n    """Pause MPD playback (fire and forget)."""\n    mpd_exchange(["pause 1"])\n\n\n# -------------------------------------------------------------- Jellyfin --\n\ndef load_jellyfin():\n    """(base, token, user_id) from the Settings sidecar\n    (~/.config/rmpc/jellyfin.ron), else jellytui\'s config.toml."""\n    override = os.environ.get("S2U_JELLYFIN_CONFIG")\n    candidates = ((\n        os.path.expanduser("~/.config/s2udio/jellyfin.ron"),\n        os.path.expanduser("~/.config/rmpc/jellyfin.ron"),\n        os.path.expanduser("~/.config/jellytui/config.toml"),\n    ) if override is None else (override,))\n    for path in candidates:\n        try:\n            with open(path) as f:\n                content = f.read()\n        except OSError:\n            continue\n        creds = {}\n        for key, value in _CONFIG_RE.findall(content):\n            creds[key] = value\n        if creds.get("server_url") and creds.get("access_token"):\n            return (creds["server_url"].rstrip("/"), creds["access_token"],\n                    creds.get("user_id", ""))\n    return None\n\n\n# Jellyfin 12 (2026-09) no longer parses the legacy X-Emby-* headers; it reads\n# the standard Authorization: MediaBrowser header. The legacy X-Emby-Token\n# header is still sent alongside it so older servers (Jellyfin 10.x/11.x,\n# Emby) keep working -- 12.x ignores the extra header.\n_JF_CLIENT = ("MediaBrowser Client=\\"s2udio\\", Device=\\"helper\\", "\n              "DeviceId=\\"s2u-helper\\", Version=\\"0.1\\"")\n\n\ndef _jf_headers(token):\n    return {"Authorization": _JF_CLIENT + ", Token=\\"" + token + "\\"",\n            "X-Emby-Token": token}\n\n\ndef jf_get(jf, url, timeout=6):\n    req = urllib.request.Request(url, headers=_jf_headers(jf[1]))\n    with urllib.request.urlopen(req, timeout=timeout) as response:\n        return response.read()\n\n\ndef jf_post(jf, url, body, timeout=6):\n    data = json.dumps(body).encode()\n    headers = _jf_headers(jf[1])\n    headers["Content-Type"] = "application/json"\n    req = urllib.request.Request(url, data=data, headers=headers)\n    with urllib.request.urlopen(req, timeout=timeout) as response:\n        return response.read()\n\n\ndef jf_item_meta(jf, item_id):\n    """(name, artist) of a Jellyfin item, mirroring s2udio\'s JfItem."""\n    base, _token, user = jf\n    data = json.loads(jf_get(\n        jf, f"{base}/Users/{user}/Items/{item_id}?Fields=Chapters"))\n    artists = data.get("Artists") or []\n    artist = (data.get("AlbumArtist") or\n              (artists[0] if artists else None) or\n              data.get("SeriesName") or "")\n    return (data.get("Name") or "(untitled)", artist)\n\n\ndef jf_write_poster(jf, item_id):\n    try:\n        base, _token, _user = jf\n        image = jf_get(jf, f"{base}/Items/{item_id}/Images/Primary?maxWidth=600",\n                       timeout=10)\n    except Exception:\n        return False\n    if not image:\n        return False\n    try:\n        tmp = POSTER + ".tmp"\n        with open(tmp, "wb") as f:\n            f.write(image)\n        os.replace(tmp, POSTER)\n        return True\n    except OSError:\n        return False\n\n\ndef jf_fetch_resume(jf, item_id):\n    base, _token, user = jf\n    data = json.loads(jf_get(jf, f"{base}/UserItems/{item_id}/UserData"))\n    return (data.get("PlaybackPositionTicks") or 0) / 10_000_000.0\n\n\ndef jf_report_progress(jf, item_id, position, paused):\n    base, _token, _user = jf\n    jf_post(jf, f"{base}/Sessions/Playing/Progress", {\n        "ItemId": item_id,\n        "PositionTicks": int(position * 10_000_000),\n        "IsPaused": paused,\n        "PlayMethod": "DirectPlay",\n    })\n\n\ndef jf_report_stopped(jf, item_id, position):\n    base, _token, _user = jf\n    jf_post(jf, f"{base}/Sessions/Playing/Stopped", {\n        "ItemId": item_id,\n        "PositionTicks": int(position * 10_000_000),\n        "IsPaused": False,\n        "PlayMethod": "DirectPlay",\n    })\n\n\n# ----------------------------------------------------------------- state --\n\ndef write_state(st):\n    """Write the mpv-mpris.json schema s2udio/mpDris2 use, atomically."""\n    doc = {\n        "title": st.get("title") or "",\n        "artist": st.get("artist") or "",\n        "art": st.get("art") or "",\n        "playing": not st.get("paused", False),\n        "position": st.get("position") or 0,\n        "duration": st.get("duration") or 0,\n        "socket": st.get("socket") or "",\n        "item_id": st.get("item_id") or "",\n        "volume": st.get("volume"),\n        "playlist": st.get("playlist") or [],\n        "playlist_pos": st.get("playlist_pos"),\n    }\n    try:\n        os.makedirs(CACHE, exist_ok=True)\n        tmp = STATE + ".tmp"\n        with open(tmp, "w") as f:\n            json.dump(doc, f)\n        os.replace(tmp, STATE)\n    except OSError:\n        pass\n\n\ndef delete_state():\n    try:\n        os.remove(STATE)\n    except OSError:\n        pass\n\n\ndef claim_pid():\n    """One tracker per session; exit silently when another is alive."""\n    try:\n        os.makedirs(CACHE, exist_ok=True)\n        if os.path.exists(PID_FILE):\n            try:\n                with open(PID_FILE) as f:\n                    old = int(f.read().strip())\n                with open(f"/proc/{old}/cmdline", "rb") as f:\n                    cmdline = f.read().decode("utf-8", "replace")\n                if "s2u-helper" in cmdline or "s2u-mpv-tracker" in cmdline:\n                    return False\n            except Exception:\n                pass\n        with open(PID_FILE, "w") as f:\n            f.write(str(os.getpid()))\n        return True\n    except OSError:\n        return True\n\n\ndef release_pid():\n    try:\n        with open(PID_FILE) as f:\n            if f.read().strip() == str(os.getpid()):\n                os.remove(PID_FILE)\n    except OSError:\n        pass\n\n\ndef mpdris2(action):\n    """Hide the paused MPD audio MPRIS while a video session is alive.\n\n    mpDris2 (org.mpris.MediaPlayer2.mpd) always reports MPD\'s state —\n    including "Paused" while a video plays in mpv — so desktop media\n    controls would show a stale audio entry next to the video one. The\n    tracker stops mpDris2.service at session start and restarts it when\n    mpv exits (audio MPRIS returns for the resumed MPD playback). The\n    service is driven through scripts/s2u-svc (the init abstraction from\n    plan §6.1) instead of a hardcoded systemctl invocation: on systemd\n    targets its systemd-user backend issues the identical systemctl\n    command, and on non-systemd targets it maps to the runit/s6/openrc/\n    sysvinit/launcher backends.\n\n    Skipped when S2U_MPV_SOCKET is set: tests drive the tracker with a\n    fake socket and must not touch the real service.\n    """\n    if os.environ.get("S2U_MPV_SOCKET"):\n        return\n    try:\n        subprocess.run(["s2u-helper", "svc", action, "mpDris2.service"],\n                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,\n                       stderr=subprocess.DEVNULL, timeout=15)\n    except Exception:\n        pass\n\n\ndef spawn_mpris_bridge():\n    """Start the bundled s2udio-mpris daemon if it is not already running.\n\n    It exposes this state file (~/.cache/rmpc/mpv-mpris.json) over D-Bus\n    (org.mpris.MediaPlayer2.s2udio) so desktop media controls show the mpv\n    video; it exits itself when the state file goes stale. Fire and forget.\n\n    Skipped when S2U_MPV_SOCKET is set: tests drive the tracker with a\n    fake socket and must not spawn the real bridge.\n    """\n    if os.environ.get("S2U_MPV_SOCKET"):\n        return\n    try:\n        # -f with a bracket guard: the process comm is "python3" so -x never\n        # matches (which would respawn a duplicate every 30 s, exiting on the\n        # taken bus name); the bracket pattern avoids matching this script.\n        r = subprocess.run(["pgrep", "-f", "([s]2udio-mpris|[s]2u-helper mpris)"],\n                           stdout=subprocess.DEVNULL,\n                           stderr=subprocess.DEVNULL, timeout=3)\n        if r.returncode == 0:\n            return\n    except Exception:\n        pass\n    try:\n        with open(os.devnull, "wb") as devnull:\n            subprocess.Popen(["s2u-helper", "mpris"], stdin=devnull,\n                             stdout=devnull, s