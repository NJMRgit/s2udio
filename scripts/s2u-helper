.service.method(PLAYER, in_signature="ox", out_signature="")\n    def SetPosition(self, _track, pos_us):\n        mpv_command(["seek", pos_us / 1_000_000, "absolute"])\n\n    @dbus.service.method(PLAYER, in_signature="s", out_signature="")\n    def OpenUri(self, _uri):\n        pass\n\n    # ---- org.freedesktop.DBus.Properties ---------------------------------\n    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")\n    def Get(self, iface, name):\n        # Every MPRIS property a client can ask for must be served here:\n        # KDE\'s media controls read properties via org.freedesktop.DBus\n        # .Properties.Get, and a missing key returns None -> dbus-python\n        # replies with a TypeError the client cannot parse (the timeline\n        # entry then shows no info at all). Position + Volume in\n        # particular are NOT plain class methods clients reach directly.\n        if iface == INTERFACE:\n            return {\n                "Identity": "s2udio (mpv)",\n                "DesktopEntry": "s2udio",\n                "CanQuit": False,\n                "CanRaise": False,\n                "CanSetFullscreen": False,\n                "HasTrackList": False,\n                "Fullscreen": False,\n                "SupportedUriSchemes": dbus.Array([], signature="s"),\n                "SupportedMimeTypes": dbus.Array([], signature="s"),\n            }.get(name)\n        if iface == PLAYER:\n            return {\n                "PlaybackStatus": self.PlaybackStatus(),\n                "Metadata": self.Metadata(),\n                "Position": self._position(),\n                "Volume": self.Volume(),\n                "CanPlay": True,\n                "CanPause": True,\n                "CanSeek": True,\n                "CanControl": True,\n                "CanGoNext": False,\n                "CanGoPrevious": False,\n                "Rate": 1.0,\n                "MinimumRate": 1.0,\n                "MaximumRate": 1.0,\n            